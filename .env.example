# Pine — environment variables (names + purpose; no real values here)
# Copy to .env.local; set the same in Vercel. One per line, no spaces around "=".
# NEXT_PUBLIC_* are inlined at BUILD time — set them before `next build`.

# Database
MONGODB_URI=                       # REQUIRED. Mongo connection string (Atlas in prod).
MONGODB_DB=pine                    # DB name (falls back: MONGODB_DB -> MONGODB_DATABASE).

# Auth
JWT_SECRET=                        # REQUIRED. Signs session cookies.
GOOGLE_CLIENT_ID=                  # REQUIRED.
GOOGLE_CLIENT_SECRET=              # REQUIRED.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=      # REQUIRED, build-time. Same value as GOOGLE_CLIENT_ID.

# LLM (OpenRouter, OpenAI-compatible)
OPENAI_API_KEY=                    # REQUIRED. OpenRouter key (sk-or-v1-...).
OPENAI_API_URL=                    # Optional. Defaults to https://openrouter.ai/api/v1.
OPENAI_MODEL=                      # Optional. Defaults to google/gemini-2.5-flash.

# Object storage (S3-compatible; Cloudflare R2 in prod) — REQUIRED for uploads/PDF/material rendering
S3_BUCKET=
S3_REGION=                         # "auto" for R2; real region for AWS.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=                       # R2/MinIO only; omit for AWS S3.

# Email (Resend)
RESEND_API_KEY=                    # REQUIRED to send candidate emails.
RESEND_FROM=                       # "Pine Finance <noreply@verified-domain>". Domain must be verified.

# URLs
APP_URL=                           # REQUIRED for working report links in emails.
NEXT_PUBLIC_SITE_URL=

# Optional
OWNER_OPEN_ID=
